# CLEARANCE kör mot sitt EGET API. Det finns ingen backend-variabel att
# sätta: appen och API:t serveras från samma ursprung på Vercel, och en
# relativ fetch mot /v1/... går rätt via rewriten i vercel.json.
#
# VITE_API_BASE_URL behövs bara i utvecklingsläget, där Vite och den egna
# servern kör på olika portar.
VITE_API_BASE_URL=

# Runs the whole app in the browser against invented data, with no backend.
# For previews and demonstrations only. Any value other than exactly "true"
# leaves the real adapter in place.
VITE_DEMO_MODE=false
