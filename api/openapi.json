  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "API-nyckel per organisation (Authorization: Bearer clr_...), hanterad i driftens valv. Nyckeln känns igen på prefixet clr_. Samma radskydd som appen: API:t ser det kontots roller ser."
      },
      "session": {
        "type": "http",
        "scheme": "bearer",
        "description": "Sessionstoken från POST /auth/login (Authorization: Bearer ...). Används av appen; en integration använder API-nyckel."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "unauthorized",
              "forbidden",
              "not_found",
              "validation_failed",
              "payment_required",
              "conflict",
              "rate_limited",
              "internal"
            ]
          },
          "message": {
            "type": "string",
            "description": "Läsbart, på svenska. Ärligt: rollfel är information, inte teknikfel."
          }
        }
      },
      "Case": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "orgNumber": {
            "type": "string"
          },
          "companyName": {
            "type": [
              "string",
              "null"
            ]
          },
          "recommendationType": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "bankruptcy",
              "reconstruction",
              "stabilize",
              null
            ]
          },
          "totalDebt": {
            "type": [
              "string",
              "null"
            ]
          },
          "quickLiquidationValue": {
            "type": [
              "string",
              "null"
            ]
          },
          "closedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "exitReason": {
            "type": [
              "string",
              "null"
            ]
          },
          "healthMode": {
            "type": "boolean"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "JournalEvent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "action": {
            "type": "string"
          },
          "objectType": {
            "type": "string"
          },
          "objectId": {
            "type": [
              "string",
              "null"
            ]
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Document": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "fileName": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "reviewStatus": {
            "type": "string",
            "enum": [
              "draft",
              "in_review",
              "approved"
            ]
          },
          "reviewedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Decision": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "premise": {
            "type": [
              "string",
              "null"
            ],
            "description": "Omprövningsvillkoret i ord: det som gällde när beslutet togs. Fritext, skriven av en människa."
          },
          "decidedAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "reconsidered"
            ]
          },
          "reconsideredAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "watch": {
            "type": [
              "object",
              "null"
            ],
            "description": "Den del av premissen som går att räkna om. Null = premissen bevakas inte, och det sägs rakt ut i gränssnittet i stället för att antydas.",
            "properties": {
              "signal": {
                "type": "string",
                "enum": [
                  "loner",
                  "skatt",
                  "skuldtackning",
                  "passerade_frister",
                  "hyra",
                  "leverantorer",
                  "skuld"
                ]
              },
              "comparator": {
                "type": "string",
                "enum": [
                  "minst",
                  "hogst",
                  "sant",
                  "falskt"
                ]
              },
              "threshold": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Tröskeln för minst/högst. Null för de booleska villkoren."
              }
            }
          },
          "watchAckObservation": {
            "type": [
              "string",
              "null"
            ],
            "description": "Observationen som kvitterades med \"beslutet står fast\". Kvitteringen är knuten till observationen, inte till beslutet: frågan kommer tillbaka när läget ändras igen."
          },
          "watchAckAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "label": {
            "type": "string"
          },
          "dueDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "doneAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "assignedTo": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ShareLink": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "scope": {
            "type": "string",
            "enum": [
              "overview",
              "full"
            ]
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "revokedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "accessCount": {
            "type": "integer",
            "description": "Varje öppning loggas."
          }
        }
      },
      "SharedCaseView": {
        "type": "object",
        "description": "Exakt samma datamodell som den mänskliga live-vyn. Data - aldrig bedömningar.",
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "overview",
              "full"
            ]
          },
          "orgNumber": {
            "type": "string"
          },
          "companyName": {
            "type": [
              "string",
              "null"
            ]
          },
          "recommendationTitle": {
            "type": [
              "string",
              "null"
            ]
          },
          "totalDebt": {
            "type": [
              "string",
              "null"
            ]
          },
          "quickLiquidationValue": {
            "type": [
              "string",
              "null"
            ]
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "documents": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/Document"
            }
          }
        }
      },
      "GoogleFacts": {
        "type": "object",
        "description": "Uppgifter ur Google Places. Recensenternas namn, bilder och länkar hämtas aldrig – vi läser omdömet om bolaget, inte om människan som skrev det. Innehållet får cachas i högst 30 dagar; placeId utan tidsgräns.",
        "properties": {
          "placeId": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "website": {
            "type": "string",
            "nullable": true,
            "description": "Bolagets webbadress. Detta är uppgiften som gör att webbplatsläsaren kan köra utan att fråga användaren."
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "address": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "oppet",
              "tillfalligt-stangt",
              "permanent-stangt",
              "okant"
            ],
            "description": "Verksamhetsstatus hos Google. permanent-stangt på ett levande bolag är en uppgift som syns för alla som söker på bolaget och som kan behöva rättas."
          },
          "reviews": {
            "type": "object",
            "properties": {
              "rating": {
                "type": "number",
                "nullable": true
              },
              "count": {
                "type": "integer"
              },
              "excerpts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "basis": {
            "type": "array",
            "description": "Grunden för varje fält, så att frågan var en uppgift kommer ifrån går att besvara.",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
