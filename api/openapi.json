                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "uploadDocument",
        "summary": "Ladda upp dokument till akten",
        "x-status": "beta",
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "description": "Fel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/documents/{documentId}/review": {
      "post": {
        "operationId": "setDocumentReview",
        "summary": "Granskningsövergång: request/approve/reset. Godkännande kräver rådgivarroll - prövas i backend.",
        "x-status": "beta",
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "description": "Fel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/cases/{caseId}/decisions": {
      "get": {
        "operationId": "listDecisions",
        "summary": "Beslutsminnet: protokollförda beslut med premiss",
        "x-status": "beta",
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "description": "Fel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "recordDecision",
