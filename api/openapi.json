        "x-status": "beta",
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "description": "Fel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/decisions/{decisionId}/reconsider": {
      "post": {
        "operationId": "reconsiderDecision",
        "summary": "Ompröva - aldrig ändra: en stämplad markering ovanpå, originalet står kvar",
        "x-status": "beta",
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "description": "Fel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/cases/{caseId}/tasks": {
      "get": {
        "operationId": "listTasks",
        "summary": "Uppgifterna i handlingsplanen",
        "x-status": "beta",
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "description": "Fel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateTasks",
        "summary": "Bocka av eller delegera uppgifter",
        "x-status": "beta",
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "description": "Fel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/cases/{caseId}/report": {
      "get": {
        "operationId": "getReport",
        "summary": "Rapporten ur samma datamodell, som JSON eller PDF",
        "x-status": "beta",
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "description": "Fel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "pdf"
              ]
            }
          }
        ]
      }
    },
    "/cases/{caseId}/share-links": {
      "get": {
        "operationId": "listShareLinks",
        "summary": "Ärendets live-länkar med åtkomsträkning",
        "x-status": "beta",
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "description": "Fel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createShareLink",
        "summary": "Skapa live-länk (nivå overview/full, tidsbegränsad, återkallbar)",
        "x-status": "beta",
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "description": "Fel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/share-links/{linkId}": {
      "delete": {
        "operationId": "revokeShareLink",
        "summary": "Återkalla live-länken - omedelbar verkan",
        "x-status": "beta",
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "description": "Fel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/shared/{token}": {
      "get": {
        "operationId": "getSharedCase",
        "summary": "Live-ärendelänkens maskinläsbara nuläge. Publik: skyddet är tidsgräns, återkallbarhet och åtkomstlogg. Samma tystnad för okända, utgångna och återkallade länkar.",
        "x-status": "live",
        "responses": {
          "200": {
            "description": "Ärendets nuläge, scopat",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SharedCaseView"
                }
              }
            }
          },
          "404": {
            "description": "Okänd, utgången eller återkallad länk - samma tystnad"
          }
        },
        "security": [],
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    }
  },
  "webhooks": {
    "document.created": {
      "post": {
        "operationId": "whDocumentCreated",
        "summary": "Ett dokument laddades upp",
        "x-status": "beta",
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "description": "Fel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "document.review_changed": {
      "post": {
        "operationId": "whDocumentReview",
        "summary": "Granskningsstatus ändrades (för granskning/godkänt/utkast)",
        "x-status": "beta",
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "description": "Fel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "case.status_changed": {
      "post": {
        "operationId": "whCaseStatus",
        "summary": "Ärendet ändrade status eller avslutades",
        "x-status": "beta",
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "description": "Fel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "decision.recorded": {
      "post": {
        "operationId": "whDecisionRecorded",
        "summary": "Ett beslut protokollfördes med premiss",
        "x-status": "beta",
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "description": "Fel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "decision.reconsidered": {
      "post": {
        "operationId": "whDecisionReconsidered",
        "summary": "Ett beslut omprövades",
        "x-status": "beta",
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
