    "/sources/google": {
      "post": {
        "operationId": "lookupCompanyAtGoogle",
        "summary": "Slår upp bolaget hos Google",
        "description": "Hämtar webbadress, besöksadress, telefon, omdömen och verksamhetsstatus ur Google Places. Ger ALDRIG organisationsnummer, styrelse, F-skatt eller momsregistrering – Places känner till platser och verksamheter, inte juridiska personer. Kräver inloggning trots att uppgifterna är offentliga: Places debiteras per anrop, och en öppen rutt är någon annans trafik på vår faktura. Svarets status skiljer på traff, ingen-traff (bolaget kunde inte matchas entydigt), ingen-kalla (ingen nyckel i driften) och fel (Google svarade inte). De fyra får inte slås ihop – ett driftfel som ser ut som ingen-traff blir ett påstående om bolaget.",
        "x-status": "beta",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "companyName"
                ],
                "properties": {
                  "companyName": {
                    "type": "string",
                    "description": "Bolagets namn. Matchas exakt efter att bolagsformen skalats bort."
                  },
                  "ort": {
                    "type": "string",
                    "description": "Ort, när den är känd. Enda sättet att skilja två likadana namn åt."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Utfallet av uppslaget",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": [
                        "status",
                        "facts"
                      ],
                      "properties": {
                        "status": {
                          "type": "string",
                          "enum": [
                            "traff"
                          ]
                        },
                        "facts": {
                          "$ref": "#/components/schemas/GoogleFacts"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": [
                        "status",
                        "reason"
                      ],
                      "properties": {
                        "status": {
                          "type": "string",
                          "enum": [
                            "ingen-traff",
                            "ingen-kalla",
                            "fel"
                          ]
                        },
                        "reason": {
                          "type": "string"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Fel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/tasks/{taskId}/done": {
