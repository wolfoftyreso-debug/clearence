# CLEARANCE frontend - nginx.
#
# Servar SPA:n OCH proxar API:t på samma origin: /v1 går till API-tjänsten.
# Det löser två saker på en gång - ingen CORS behövs (API:t har ingen), och
# klienten kan använda en relativ bas oavsett värdnamn.
#
# ${API_UPSTREAM} fylls i vid start av nginx-avbildens template-mekanism
# (envsubst). $host, $uri m.fl. är NGINX-variabler och lämnas i fred.

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Säkerhetsrubriker - det CloudFront gjorde förr.
    #
    # VARNING TILL DEN SOM ÄNDRAR: nginx ÄRVER INTE add_header ned i ett
    # location-block som har egna add_header. Rubrikerna nedan gällde därför
    # inte för `location = /index.html` eller `location /assets/`, som båda
    # sätter Cache-Control - alltså saknade själva appdokumentet både
    # klickkapningsskydd och nosniff. De upprepas nu i varje sådant block,
    # och tests/sakerhet.ts faller om någon tar bort dem igen.
    #
    # CSP:n tillåter 'unsafe-inline' för STIL, inte för skript: Tailwind och
    # den runtime-konfig nginx skjuter in i index.html är inline-stil/skript
    # vi själva äger. Skript begränsas till samma origin; allt utifrån är
    # blockerat, och sidan får inte ramas in av någon.
    set $clearance_csp "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'";

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Content-Security-Policy $clearance_csp always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    # HSTS: TLS termineras i ingressen, men rubriken måste komma från
    # ursprunget för att gälla. Två år, med underdomäner.
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

    gzip on;
    gzip_vary on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # API:t på samma origin. Ingen CORS, ingen andra-host.
    location /v1/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    # Hash-namngivna tillgångar cachas hårt; allt annat inte.
    # Säkerhetsrubrikerna UPPREPAS - se varningen ovan.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        add_header Content-Security-Policy $clearance_csp always;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        try_files $uri =404;
    }

    # index.html ska aldrig cachas - runtime-konfigen skjuts in i den vid
    # start, och en cachad kopia skulle låsa fel API-bas.
    # Det HÄR är dokumentet användaren faktiskt laddar: utan rubrikerna
    # nedan gick hela appen att rama in på en annan sajt.
    location = /index.html {
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        add_header Content-Security-Policy $clearance_csp always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        try_files $uri =404;
    }

    # SPA-routing: react-router äger vägarna, servern svarar med appen.
    location / {
        try_files $uri /index.html;
    }
}
