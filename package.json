    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "npm run test:bank && npm run test:reports && npm run test:financial && npm run test:crisis && npm run test:billing && npm run test:email && npm run test:integrations && npm run test:sie && npm run test:actionplan && npm run test:templates && npm run test:knowledge && npm run test:summary && npm run test:portfolio && npm run test:audit && npm run test:tasks && npm run test:pdf && npm run test:notifications && npm run test:leads && npm run test:language && npm run test:presentation && npm run test:advisor && npm run test:options && npm run test:pricing",
    "test:crisis": "esbuild tests/crisisAnalysis.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/test-crisis.cjs --log-level=error && node node_modules/.cache/test-crisis.cjs",
    "test:rls": "bash supabase/tests/run.sh",
    "test:selfhosted": "bash db/tests/run.sh",
    "test:mobile": "node tests/browser/mobile.mjs",
