{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["arn1"],
  "functions": {
    "api/[...path].ts": { "maxDuration": 30 },
    "api/cron/nattjobb.ts": { "maxDuration": 300 },
    "api/cron/utkorg.ts": { "maxDuration": 120 },
    "api/cron/aviseringar.ts": { "maxDuration": 120 },
    "api/cron/simulering.ts": { "maxDuration": 300, "memory": 3009 }
  },
  "crons": [
    { "path": "/api/cron/utkorg", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/aviseringar", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/simulering", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/nattjobb", "schedule": "15 3 * * *" }
  ],
  "rewrites": [
    { "source": "/v1/:path*", "destination": "/api/v1/:path*" },
    { "source": "/((?!api/|assets/|_vercel/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self'; frame-src 'self' blob:; object-src 'self' blob:; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}
